{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diario-emocional-mqc",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diario-emocional-mqc",
      "database_id": "e6ad6e91-1b18-4990-8d22-05ca9e253af7",
      "migrations_dir": "drizzle"
    }
  ],
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "diario-emocional-mqc-preview",
        "database_id": "dbbf4141-9657-437a-a76f-def866743a7a",
        "migrations_dir": "drizzle"
      }
    ]
  },
  "routes": [
    {
      "pattern": "diario.jenifferpires.life/*",
      "zone_name": "jenifferpires.life"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
